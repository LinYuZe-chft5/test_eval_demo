# ============================================================
# 学科诊断应用 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# Supabase 项目配置
# 你的 Supabase 项目 URL (在 Supabase Dashboard → Settings → General 中获取)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (在 Supabase Dashboard → Settings → API 中获取)
# 注意：此密钥仅用于服务器端，切勿在前端代码中暴露
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 管理员账号(MVP单一管理员)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"

# 防滥用(规则常量)
MAX_SESSIONS_PER_IP_PER_HOUR=10

# LLM API 配置（五层流水线 Layer 2 & Layer 5）
# 支持 OpenAI 兼容格式的 API
# 未配置时自动降级为程序判分+模板生成（Demo可用）
LLM_API_URL="https://api.openai.com/v1/chat/completions"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Node 环境
NODE_ENV=development
