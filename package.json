{
  "name": "h5-diag-app",
  "version": "0.1.0",
  "private": true,
  "description": "H5线上学科诊断验证应用(MVP) - 教育测量产品",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed_questions.ts",
    "seed:all": "tsx scripts/seed_questions.ts && tsx scripts/seed_blueprints.ts && tsx scripts/seed_kp_dependencies.ts && tsx scripts/seed_method_cards.ts",
    "seed:s3_s6": "tsx scripts/seed_s3_s6.ts",
    "convert:s3_s6": "node scripts/convert_s3_s6_seed.js",
    "fix:latex": "tsx scripts/fix_latex_data.ts",
    "fix:steps": "tsx scripts/fix_step_prompts.ts",
    "fix:all-data": "npm run fix:latex && npm run fix:steps",
    "reimport:all": "node scripts/reimport_all_data.cjs",
    "enhance:metadata": "node scripts/enhance_metadata.cjs",
    "test:llm": "tsx scripts/test_llm_connection.ts",
    "diagnose:env": "tsx scripts/diagnose_env.ts",
    "generate:env": "tsx scripts/generate_env.ts",
    "clean:latex": "tsx scripts/clean_latex_seeds.ts",
    "reimport:cleaned": "node scripts/reimport_all_cleaned.cjs",
    "reimport:s3_s6": "npm run fix:all-data && npm run seed:s3_s6",
    "test:api": "tsx scripts/test_api.ts",
    "gen-codes": "tsx scripts/gen_access_codes.ts",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:pull": "prisma db pull",
    "db:setup": "prisma db pull && prisma generate && tsx scripts/seed_questions.ts && tsx scripts/seed_blueprints.ts && tsx scripts/seed_kp_dependencies.ts && tsx scripts/seed_method_cards.ts && tsx scripts/gen_access_codes.ts -- --sku=S1_XIAOSHENGCHU_MATH --count=5"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@prisma/client": "^5.20.0",
    "nanoid": "^5.0.7",
    "katex": "^0.16.11",
    "react-katex": "^3.0.1",
    "recharts": "^2.13.0",
    "zod": "^3.23.8",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/katex": "^0.16.7",
    "@types/react-katex": "^3.0.4",
    "@types/pg": "^8.11.10",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.2",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15"
  }
}
